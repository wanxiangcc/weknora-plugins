+// ResolveResourceFields lists one resource's selectable children, passing the
+// name hint through so connectors with expensive listings can look the resource
+// up directly instead of listing everything.
+func (s *DataSourceService) ResolveResourceFields(
+	ctx context.Context, dsID string, resourceID string, nameHint string,
+) ([]types.Resource, error) {
+	ds, err := s.GetDataSource(ctx, dsID)
+	if err != nil {
+		return nil, err
+	}
+	connector, err := s.connectorRegistry.Get(ds.Type)
+	if err != nil {
+		return nil, err
+	}
+	config, err := ds.ParseConfig()
+	if err != nil {
+		return nil, datasource.ErrInvalidConfig
+	}
+	if resolver, ok := connector.(datasource.ResourceFieldsResolver); ok {
+		return resolver.ResolveResourceFields(ctx, config, resourceID, nameHint)
+	}
+	return connector.ListResources(ctx, config, resourceID)
+}
+
+// SearchAvailableResources lists only the resources whose name matches keyword.
+//
+// Connectors with a very large listing implement datasource.ResourceSearcher and
+// filter server-side; the rest fall back to one listing filtered by name, so the
+// API is uniform across connectors and no connector had to change.
+func (s *DataSourceService) SearchAvailableResources(
+	ctx context.Context, dsID string, keyword string,
+) ([]types.Resource, error) {
+	keyword = strings.TrimSpace(keyword)
+	if keyword == "" {
+		// Never answer "everything": the caller asked to avoid that.
+		return []types.Resource{}, nil
+	}
+	ds, err := s.GetDataSource(ctx, dsID)
+	if err != nil {
+		return nil, err
+	}
+	connector, err := s.connectorRegistry.Get(ds.Type)
+	if err != nil {
+		return nil, err
+	}
+	config, err := ds.ParseConfig()
+	if err != nil {
+		return nil, datasource.ErrInvalidConfig
+	}
+	if searcher, ok := connector.(datasource.ResourceSearcher); ok {
+		return searcher.SearchResources(ctx, config, keyword)
+	}
+	all, err := connector.ListResources(ctx, config, "")
+	if err != nil {
+		logger.Errorf(ctx, "failed to list resources for search: %v", err)
+		return nil, err
+	}
+	needle := strings.ToLower(keyword)
+	match := make([]types.Resource, 0, 16)
+	for _, resource := range all {
+		if strings.Contains(strings.ToLower(resource.Name), needle) {
+			match = append(match, resource)
+		}
+	}
+	return match, nil
+}
