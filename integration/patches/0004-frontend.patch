diff --git a/frontend/src/api/datasource/index.ts b/frontend/src/api/datasource/index.ts
index 19096307..f86ce0db 100644
--- a/frontend/src/api/datasource/index.ts
+++ b/frontend/src/api/datasource/index.ts
@@ -124,8 +124,22 @@ export function validateCredentials(type: string, credentials: Record<string, an
 // listResources lists selectable resources for a data source. Pass parentId to
 // lazily load the direct children of a resource (e.g. expanding a Feishu wiki
 // space/node), which avoids traversing the whole tree up front.
-export function listResources(id: string, parentId?: string) {
-  const query = parentId ? `?parent_id=${encodeURIComponent(parentId)}` : ''
+// Resource listing has three modes, and the picker uses all three:
+//   parentId            → that resource's children (e.g. a report's fields)
+//   { keyword }         → name search (large listings filter server-side)
+//   neither             → the whole top-level listing
+// `name` accompanies parentId so a connector with an expensive listing can find
+// that one resource by name instead of listing everything to resolve its id.
+export function listResources(
+  id: string,
+  parentId?: string,
+  options?: { keyword?: string; name?: string },
+) {
+  const params = new URLSearchParams()
+  if (parentId) params.set('parent_id', parentId)
+  if (options?.keyword) params.set('keyword', options.keyword)
+  if (options?.name) params.set('name', options.name)
+  const query = params.toString() ? `?${params.toString()}` : ''
   return get(`/api/v1/datasource/${id}/resources${query}`, { timeout: 120000 })
 }
 
