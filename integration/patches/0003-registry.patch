 }
 
+func TestConnectorRegistryIncludesSeeyon(t *testing.T) {
+	registry, err := initConnectorRegistry()
+	if err != nil {
+		t.Fatalf("initConnectorRegistry() error = %v", err)
+	}
+	connector, err := registry.Get(types.ConnectorTypeSeeyon)
+	if err != nil {
+		t.Fatalf("Seeyon connector is not registered: %v", err)
+	}
+	if connector.Type() != types.ConnectorTypeSeeyon {
+		t.Fatalf("connector.Type() = %q", connector.Type())
+	}
+	// Reports are fetched part by part and reconciled against the stored
+	// cursor, so both streaming interfaces are part of the contract.
+	if _, ok := connector.(datasource.StreamingConnector); !ok {
+		t.Fatal("Seeyon connector must implement datasource.StreamingConnector")
+	}
+	if _, ok := connector.(datasource.FullStreamingConnector); !ok {
+		t.Fatal("Seeyon connector must implement datasource.FullStreamingConnector")
+	}
+}
+
 // Every registered connector must also be advertised in the metadata registry:
 // the data source picker is built from that map, so a missing entry silently
 // hides a working connector. The reverse direction is intentionally not
